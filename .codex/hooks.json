{
  "description": "Typecheck after Codex edits TypeScript files.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|functions\\.exec|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/typecheck_after_ts_edit.mjs\"",
            "statusMessage": "Typechecking TypeScript changes",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
