rules_version = '2';

// Every document in this app lives under /users/{userId}. Isolation is enforced
// by matching the path segment against the caller's verified uid, so a query or
// write can never reach another user's data even if client code is wrong.
//
// The client passes userId as an argument (see ChatRepository), so the rules are
// the only thing standing between a bug and a data leak. Deploy with:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validThread(threadId) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'createdAt', 'updatedAt', 'guestImportFingerprint'
        ])
        && request.resource.data.keys().hasAll(['id', 'title', 'createdAt', 'updatedAt'])
        && request.resource.data.id == threadId
        && request.resource.data.title is string
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && (!('guestImportFingerprint' in request.resource.data)
          || request.resource.data.guestImportFingerprint.matches('^[a-f0-9]{64}$'));
    }

    function validMessage(messageId) {
      return request.resource.data.keys().hasOnly([
          'id', 'role', 'content', 'timestamp', 'status'
        ])
        && request.resource.data.keys().hasAll(['id', 'role', 'content', 'timestamp', 'status'])
        && request.resource.data.id == messageId
        && request.resource.data.role in ['user', 'assistant']
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 65536
        && request.resource.data.timestamp is number
        && request.resource.data.status in ['loading', 'streaming', 'done', 'error', 'interrupted'];
    }

    match /users/{userId}/threads/{threadId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && validThread(threadId);
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && validMessage(messageId);
        allow delete: if false;
      }
    }

    // Nothing else in this database is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
