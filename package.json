{
  "name": "workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:worker": "vitest run --config worker/vitest.config.mts",
    "test:integration": "firebase emulators:exec --only firestore --project demo-workbench 'pnpm exec vitest run --config vitest.integration.config.mts'",
    "test:types": "vitest run --typecheck.only",
    "coverage": "vitest run --coverage",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --var ALLOWED_ORIGIN:http://localhost:3000,https://localhost:3000,http://localhost:3001,https://localhost:3001",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.toml",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "format": "biome format --write",
    "curriculum:build": "node meta/scripts/generate-curriculum.js",
    "curriculum:query": "node meta/scripts/curriculum-query.js",
    "track": "node meta/scripts/track-progress.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@10.18.1"
}
